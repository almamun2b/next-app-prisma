# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_app?schema=public"

# ── App ──────────────────────────────────────────────────
# Public base URL (used for metadata, sitemap, canonical URLs)
APP_URL=http://localhost:3000

# ── Auth.js (NextAuth v5) ───────────────────────────────
AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=replace-with-a-32-byte-random-secret
AUTH_TRUST_HOST=true

# ── Seeded administrator (pnpm db:seed) ─────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="change-me-Str0ng!"
ADMIN_NAME="System Admin"
